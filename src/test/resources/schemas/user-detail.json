{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["responseCode", "user"],
  "properties": {
    "responseCode": { "enum": [200] },
    "user": {
      "type": "object",
      "required": ["id", "name", "email", "first_name", "last_name", "company", "address1", "country", "state", "city", "zipcode"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "company": { "type": "string" },
        "address1": { "type": "string" },
        "country": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "zipcode": { "type": "string" }
      }
    }
  }
}
