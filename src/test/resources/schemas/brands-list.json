{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["responseCode", "brands"],
  "properties": {
    "responseCode": { "enum": [200] },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "brand"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "brand": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
